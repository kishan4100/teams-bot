# Copy to bot/.env and fill in. Never commit the real .env (it is gitignored).

# --- Kompass AI (the project id is the credential) ---
KOMPASS_PROJECT_ID=
# Optional: the code has defaults for these; set only if the Kompass setup changes
KOMPASS_TENANT=
KOMPASS_URL=
KOMPASS_CHAT_FLOW_ID=
KOMPASS_EXTRACT_FLOW_ID=
# Optional: enables the agent workflow. Leave empty to use the Chat workflow only
KOMPASS_AGENT_FLOW_ID=

# --- Bot behaviour (all optional) ---
# Teams user id treated as HR (see config/commands for how HR is decided)
HR_USER_ID=
# Poll card look: blocks | text | tiles | image | bars
POLL_CARD_STYLE=
# Override where JSON data is stored
BOT_DATA_DIR=
POLL_DATA_DIR=
# Set to 0/false to turn the scheduler off (check poll/scheduler.js for exact values)
POLL_SCHEDULER=

# --- Teams identity: normally injected by Microsoft 365 Agents Toolkit from env/.env.* files ---
# Do not put real values in this file.
# CLIENT_ID=
# CLIENT_PASSWORD=
# TENANT_ID=
# BOT_TYPE=
# PORT=3978
